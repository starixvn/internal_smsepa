<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    </configSections>
    <connectionStrings>
        <add name="SMSEPA" connectionString="packet size=4096; Data Source=CEPA-WEB001\SQLEXPRESS;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=GHREPA;integrated security=false; user id=nexcel_programmer; password=/HC3QpBwb4PwlF+0rB8tEA==;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="TimerInterval" value="86400" />
        <add key="HoursToStartService" value="1.5" />
        <add key="Email" value="epa.ghrworld.com" />
        <add key="Email.SenderName" value="Group EPA" />
        <add key="app_mail_address" value="net.tcp://10.50.70.44:8787/MailService" />
        <add key="app_mail_id" value="7" />
        <add key="SendMailEndPeriod" value="false" />
        <add key="NotSendMail" value="false" />
        <add key="SendMailAllWhenPeriodStarted" value="false" />
        <add key="EnableMonthlyPeriod" value="true" />
        <add key="StartDayCreateMonthlyPeriod" value="20" />
        <add key="AutoAddStaffIntoSemiPeriod" value="false" />
        <add key="RelativeEmailPath" value="Views\\Emails\\" />
        <add key="SiteId" value="4" />
        <add key="url" value="https://epa.ghrworld.com" />
        <add key="IsRunAtStartService" value="false" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <log4net debug="true">
        <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
            <file value="Log.txt" />
            <appendToFile value="true" />
            <rollingStyle value="Size" />
            <maxSizeRollBackups value="10" />
            <maximumFileSize value="10MB" />
            <staticLogFileName value="true" />
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
            </layout>
        </appender>
        <root>
            <level value="DEBUG" />
            <appender-ref ref="RollingLogFileAppender" />
        </root>
    </log4net>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>