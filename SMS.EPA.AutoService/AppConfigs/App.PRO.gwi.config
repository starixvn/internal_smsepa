<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    </configSections>
    <connectionStrings>
        <add name="SMSEPA" connectionString="packet size=4096; Data Source=CEPA-WEB001\SQLEXPRESS;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=GWIEPA;integrated security=false; user id=nexcel_programmer; password=/HC3QpBwb4PwlF+0rB8tEA==;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="Email" value="epa@gwibsi.com" />
        <add key="Email.SenderName" value="GWI EPA" />
        <add key="app_mail_address" value="net.tcp://10.50.70.44:8787/MailService" />
        <add key="app_mail_id" value="6" />
        <add key="SendMailEndPeriod" value="false" />
        <add key="NotSendMail" value="false" />
        <add key="SendMailAllWhenPeriodStarted" value="false" />
        <add key="EnableMonthlyPeriod" value="false" />
        <add key="StartDayCreateMonthlyPeriod" value="20" />
        <add key="RelativeEmailPath" value="Views\\Emails\\" />
        <add key="SiteId" value="3" />
        <add key="url" value="https://epa.gwibsi.com" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
            </dependentAssembly>
        </assemblyBinding>
