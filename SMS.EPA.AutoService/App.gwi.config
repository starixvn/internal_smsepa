<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    </configSections>
    <connectionStrings>
        <add name="SMSEPA" connectionString="packet size=4096; Data Source=GWIPHP115HWSV00\SQLEXPRESS;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=GWIEPA;integrated security=false; user id=nexcel_programmer; password=/HC3QpBwb4PwlF+0rB8tEA==;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="TimerInterval" value="86400" />
        <add key="HoursToStartService" value="1.4" />
        <add key="Email" value="hr.gwibsi.com" />
        <add key="Email.SenderName" value="GWIEPA" />
        <add key="app_mail_address" value="net.tcp://10.70.70.65:8787/MailService" />
        <add key="app_mail_id" value="4" />
        <add key="SendMailEndPeriod" value="false" />
        <add key="NotSendMail" value="false" />
        <add key="SendMailAllWhenPeriodStarted" value="false" />
        <add key="EnableMonthlyPeriod" value="true" />
        <add key="StartDayCreateMonthlyPeriod" value="20" />
        <add key="AutoAddStaffIntoSemiPeriod" value="true" />
        <add key="RelativeEmailPath" value="Views\\Emails\\" />
        <add key="SiteId" value="3" />
        <add key="url" value="https://epa.gwibsi.com" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <log4net debug="true">
        <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
            <file value="Log.txt" />
            <appendToFile value="true" />
            <rollingStyle value="Size" />
            <maxSizeRollBackups value="10" />
            <maximumFileSize value="10MB" />
            <staticLogFileName value="true" />
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
            </layout>
        </appender>
        <root>
            <level value="DEBUG" />
            <appender-ref ref="RollingLogFileAppender" />
        </root>
    </log4net>
</configuration>