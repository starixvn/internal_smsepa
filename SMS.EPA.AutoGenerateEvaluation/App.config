<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>
  <connectionStrings>
    <add name="SMSEPA" connectionString="packet size=4096; Data Source=10.18.200.114;TrustServerCertificate = true;Connect Timeout=60;Asynchronous Processing=true;Initial Catalog=SMSEPA_Test;integrated security=false; user id=internalteam; password=d0KQL2j6R1N8hCLjYs44tQ==;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="TimerInterval" value="86400" />
    <add key="Email" value="quinn.vo@starixsoft.com" />
    <add key="Email.SenderName" value="[SMSEPA]" />
    <add key="app_mail_address" value="net.tcp://10.18.200.103:8787/MailService" />
    <add key="app_mail_id" value="52" />
    <add key="SendMailEndPeriod" value="false" />
    <add key="NotSendMail" value="false" />
    <add key="SendMailAllWhenPeriodStarted" value="false" />
    <add key="EnableMonthlyPeriod" value="true" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="SpNames.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <log4net debug="true">
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="Log.txt" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="10MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%-5p %d %5rms %-22.22c{1} %-18.18M - %m%n" />
      </layout>
    </appender>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
</configuration>