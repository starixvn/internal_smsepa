<div class="row row-item">
    <table class="table table-bordered table-striped table-performance-result">
        <thead>
            <tr>
                <th colspan="2" data-translate="Employee"></th>
                <th colspan="3">
                    <span data-translate="Evaluator"></span>
                    <span ng-show="memberEPAInfoCtrl.epaInfo.AverageScoreByEvaluators">
                        ({{memberEPAInfoCtrl.epaInfo.AverageScoreByEvaluators | customNumber}})
                    </span>
                </th>
                <th colspan="2" data-translate="Reviewer"></th>
                <th rowspan="2" data-translate="AttendanceScore" class="col-attendance-score"
                    ng-show="memberEPAInfoCtrl.epaInfo.HasAttendanceScore"></th>
                <th rowspan="2" data-translate="TotalScore" class="col-score"></th>
            </tr>
            <tr>
                <th data-translate="TotalScore" class="col-score"></th>
                <th data-translate="Comment" class="col-comment"></th>
                <th data-translate="NickName"></th>
                <th data-translate="TotalScore" class="col-score"></th>
                <th data-translate="Comment" class="col-comment"></th>
                <th data-translate="TotalScore" class="col-score"></th>
                <th data-translate="Comment"></th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="opt in memberEPAInfoCtrl.range(memberEPAInfoCtrl.epaInfo.Rowspan) track by $index">
                <td rowspan="{{memberEPAInfoCtrl.epaInfo.Rowspan}}" class="text-center col-score"
                    ng-bind="memberEPAInfoCtrl.epaInfo.ProcessBySelf.TotalScore | customNumber" ng-show="$first"></td>
                <td rowspan="{{memberEPAInfoCtrl.epaInfo.Rowspan}}" class="text-center col-comment" ng-show="$first">
