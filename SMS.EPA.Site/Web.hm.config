        <add key="NotSendMail" value="false" />
        <add key="DefaultPassword" value="SMSep@1320$!" />
        <add key="PasswordToReset" value="123456" />
        <add key="RelativeEmailPath" value="Views\\Emails\\" />
        <add key="SiteId" value="2" />
