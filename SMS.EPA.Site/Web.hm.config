                <translators>
                    <add name="NullTranslator" type="BundleTransformer.Core.Translators.NullTranslator, BundleTransformer.Core" enabled="false" />
                </translators>
            </js>
        </core>
    </bundleTransformer>
    <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.70.70.65\private$\entlib" defaultCategory="HongMaEPA" />
