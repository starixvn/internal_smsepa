@using SMS.EPA.Resources;
@using SMS.EPA.Core.Enumerations;
@using SMS.EPA.Core.Model;

@model UserSession
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    byte siteId = (byte)ViewBag.SiteId;
}
<div class="row header">
    <a class="col-xs-12 col-sm-2 logo" href="#/">
        @switch (siteId)
        {
            case (byte)SiteId.SMS:
                <img src="~/Content/Site/Images/epa_logo.png" alt="SMS-EPA" title="SMS-EPA" />
                break;
            case (byte)SiteId.HM:
                <img src="~/Content/Site/Images/Hongma-logo.png" alt="HM-EPA" title="HM-EPA" />
                break;
            case (byte)SiteId.GWI:
                <img src="~/Content/Site/Images/GWI-logo.png" alt="GWI-EPA" title="GWI-EPA" />
                break;
            case (byte)SiteId.GROUP:
                <img src="~/Content/Site/Images/GROUP-logo.png" alt="Group-EPA" title="Group-EPA" />
                break;
            case (byte)SiteId.LEXFIN:
                <img src="~/Content/Site/Images/LEXFIN-logo.png" alt="LEXFIN-EPA" title="LEXFIN-EPA" />
                break;
            case (byte)SiteId.CTI:
                <img src="~/Content/Site/Images/CTI-logo.png" alt="CTI-EPA" title="CTI-EPA" />
                break;
            case (byte)SiteId.CTS:
                <img src="~/Content/Site/Images/CTS-logo.png" alt="CTS-EPA" title="CTS-EPA" />
                break;
        }
    </a>
    <div class="col-xs-12 col-sm-10">
        <div ng-include src="'/SourceApp/Components/Menu/Templates/index.html'"></div>
        <div id="user_utilities" class="user-info info" data-ng-controller="EmployeeProfileController as employeeProfileCtrl">
            <h2>
                @Model.FullName - @Model.NickName
            </h2>
            <a class="dropdown-arrow" href="javascript:;"></a>
            <ol>
                @if (Model.IsSpecialUser)
                {
                    <li>
                        <a href="javascript:;" data-ng-click="employeeProfileCtrl.changePassword()">@Lang.ChangePassword</a>
                    </li>
                }
                <li><a href="javascript:;" data-ng-click="employeeProfileCtrl.logout()">@Lang.Logout</a> </li>
            </ol>
        </div>
    </div>
</div>

<div class="row">
    <div data-ng-view></div>
</div>