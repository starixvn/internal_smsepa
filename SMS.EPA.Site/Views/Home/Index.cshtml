@using SMS.EPA.Resources;
@using SMS.EPA.Model.Authentication;
@model UserSession
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row header">
    <a class="logo" href="/">
        <img src="~/Content/Site/Images/logo.png" alt="SMS-EPA" title="SMS-EPA" />
    </a>
    <div class="nav">
        <nav id="navbar-example" class="navbar navbar-static top-menu" role="navigation">
            <div class="bs-example-js-navbar-collapse">
                <ul class="nav navbar-nav">
                    <li>
                        <a href="">@Lang.Home</a>
                    </li>
                    <li class="dropdown" dropdown>
                        <a id="drop1" href="#" data-role="button" class="dropdown-toggle" dropdown-toggle>@Lang.Admin<b class="caret"></b>
                        </a>
                        <ul class="dropdown-menu" data-role="button" aria-labelledby="drop1">
                            <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="KPI/Index">@Lang.KPI</a>
                            </li>
                            <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="KPIGroup/Index">@Lang.KPIGroup</a>
                            </li>
                            <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="TargetTemplate/Index">@Lang.TargetTemplate</a>
                            </li>
                            <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Employee/Index">@Lang.UserManagement</a>
                            </li>
                            <li data-role="presentation"><a data-role="menuitem" tabindex="-1" href="/Role/Index">@Lang.RoleManagement</a>
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a href="">@Lang.SelfEvaluation</a>
                    </li>
                    <li>
                        <a href="">@Lang.Evaluator</a>
                    </li>
                    <li>
                        <a href="">@Lang.Reviewer</a>
                    </li>
                    <li>
                        <a href="">@Lang.Management</a>
                    </li>
                    <li>
                        <a href="">@Lang.HumanResource</a>
                    </li>
                    <li>
                        <a href="">@Lang.Report</a>
                    </li>
                    <li>
                        <a href="">@Lang.Support</a>
                    </li>
                </ul>
            </div>
        </nav>
        <div id="user_utilities" class="user-info info" data-ng-controller="EmployeeProfileController as employeeProfileCtrl">
            <h2>@Model.EmployeeInfo.FullName - @Model.EmployeeInfo.NickName
            </h2>
            <a class="dropdown-arrow" href="javascript:;"></a>
            <ol>
                @if (@Model.EmployeeInfo.IsSpecialUser)
                { 
                    <li><a href="javascript:;" data-ng-click="employeeProfileCtrl.changePassword()">@Lang.ChangePassword</a>
                    </li>
                }
                <li><a href="javascript:;" data-ng-click="employeeProfileCtrl.logout()">@Lang.Logout</a> </li>
            </ol>
        </div>
    </div>
</div>
<div class="row" data-ng-view>
</div>
