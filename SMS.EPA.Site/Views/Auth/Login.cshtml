@using System.Web.Optimization;
@using SMS.EPA.Resources;
@using SMS.EPA.Core.Enumerations;

@model SMS.EPA.Model.Authentication.LoginModel
@{
    Layout = null;

    var title = string.Empty;
    int siteId = (int)ViewBag.SiteId;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>
        @switch (siteId)
        {
            case (int)SiteId.SMS:
                title = "Welcome to SMS EPA";
                break;
            case (int)SiteId.HM:
                title = "Welcome to HM EPA";
                break;
            case (int)SiteId.GWI:
                title = "Welcome to GWI EPA";
                break;
            case (int)SiteId.GROUP:
                title = "Welcome to Group EPA";
                break;
            case (int)SiteId.LEXFIN:
                title = "Welcome to LEXFIN EPA";
                break;
            case (int)SiteId.CTI:
                title = "Welcome to CTI EPA";
                break;
        }
        @title
    </title>
    @Styles.Render("~/Content/login/css")
</head>
<body>
    <div id="panel" class="container login">
        <div class="header-login row">
            <div class="header-contain">
                <div>
                    @switch (siteId)
                    {
                        case (int)SiteId.SMS:
                            <img src="~/Content/Site/images/epa_logo.png" />
                            break;
                        case (int)SiteId.HM:
                            <img src="~/Content/Site/images/Hongma-logo.png" />
                            break;
                        case (int)SiteId.GWI:
                            <img src="~/Content/Site/images/GWI-logo.png" />
                            break;
                        case (int)SiteId.GROUP:
                            <img src="~/Content/Site/images/GROUP-logo.png" />
                            break;
                        case (int)SiteId.LEXFIN:
                            <img src="~/Content/Site/images/LEXFIN-logo.png" />
                            break;
                        case (int)SiteId.CTI:
                            <img src="~/Content/Site/images/CTI-logo.png" />
                            break;
                    }
                </div>
                <div>
                    <img src="~/Content/Site/auth/images/lock-icon.png" />
                </div>
            </div>
        </div>
        <div id="formContainer" class="row auth">
            @using (Html.BeginForm())
            {
                @Html.TextBoxFor(model => model.Username, new { placeholder = "Username", @class = "col-sm-12 username" })
                @Html.PasswordFor(model => model.Password, new { placeholder = "Password", @class = "col-sm-12 password" })
                <input type="submit" name="submit" class="col-sm-12 btn-submit" value="Log In" />
            }
            <div class="message-error">
                @if (Model != null && !ViewData.ModelState.IsValid)
                {
                    string errMsg = ViewData.ModelState.Values.SelectMany(x => x.Errors).Select(x => x.ErrorMessage).LastOrDefault();
                    <i class="icon-error"></i>@errMsg
                }
            </div>
        </div>
    </div>
</body>
</html>