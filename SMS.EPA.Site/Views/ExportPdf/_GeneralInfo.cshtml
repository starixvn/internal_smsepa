@using SMS.EPA.Resources
@using SMS.EPA.Model

@model EPAEmployeeModel

@helper GetAvatar(string code)
{
    string path = File.Exists(Server.MapPath("~/avatars/avatar.jpg"))
               ? Server.MapPath("~/avatars/avatar.jpg")
               : string.Empty;

    var codeWithExtension = code + ".jpg";

    if (File.Exists(Server.MapPath("~/avatars/" + codeWithExtension)))
    {
        path = Server.MapPath("~/avatars/" + codeWithExtension);
    }

    <img src="@path" height="60" />
}

<table class="general-info">
    <thead>
        <tr class="table-title">
            <th colspan="5">@Lang.GeneralInfo</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td rowspan="4" class="border-b-l">@GetAvatar(Model.Code)</td>
            <td class="border-b-l" width="10%">@Lang.EmployeeCode</td>
            <td class="border-b" width="20%">@Model.Code</td>
            <td class="border-b" width="10%">@Lang.NickName</td>
            <td class="border-r-b" width="20%">@Model.NickName</td>
        </tr>
        <tr>
            <td class="border-b-l">@Lang.FullName</td>
            <td class="border-b">@Model.FullName</td>
            <td class="border-b">@Lang.JobTitle</td>
            <td class="border-r-b">@Model.JobTitleName</td>
        </tr>
        <tr>
            <td class="border-b-l">@Lang.Department</td>
            <td class="border-b">@Model.DepartmentName</td>
            <td class="border-b">@Lang.Section</td>
            <td class="border-r-b">@Model.GroupName</td>
        </tr>
        <tr>
            <td class="border-b-l">@Lang.GroupDate</td>
            <td class="border-b">@Model.JoinedDate.ToString("dd MMM, yyyy")</td>
            <td class="border-b"></td>
            <td class="border-r-b"></td>
        </tr>
    </tbody>
</table>