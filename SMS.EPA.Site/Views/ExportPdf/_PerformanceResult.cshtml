@using SMS.EPA.Resources
@using SMS.EPA.Core.Enumerations
@using SMS.EPA.Model

@model EPAModel

@{
    int rowspan = Model.Rowspan;
    int totalcol = Model.IsSemiHasMonthly ? (Model.Process.Managements.Any() ? 9 : 7) : (Model.Process.Managements.Any() ? 10 : 8);
}

@helper GetScoreFromProcess(EPAProcessModel process, ScoreRatingTypeModel scoreRatingType)
{
    float maxScore = scoreRatingType.SelfEvaluated;
    switch (process.ProcessId)
    {
        case (byte)ProcessType.Self:
            maxScore = scoreRatingType.SelfEvaluated;
            break;

        case (byte)ProcessType.Evaluator:
            maxScore = scoreRatingType.Evaluator;
            break;

        case (byte)ProcessType.Reviewer:
            maxScore = scoreRatingType.Reviewer;
            break;

        case (byte)ProcessType.Management:
            maxScore = scoreRatingType.Management;
            break;
    }

    string cssClass = "";

    if (process.StatusId == (int)ProcessStatusType.InProgress)
    {
        cssClass = "red";
    }

    <span class="@cssClass">
        @(string.IsNullOrEmpty(process.TotalScore) ? Lang.NotAvailable : process.TotalScore + " / " + maxScore)
    </span>
}

<table class="performance-result">
    <thead>
        <tr class="table-title">
            <th colspan="@totalcol">@Lang.PerformanceResult</th>
        </tr>
        <tr>
            @if (Model.IsSemiHasMonthly)
            {
                <th rowspan="2">@Lang.EmployeeScore</th>
                <th rowspan="2">@Lang.EvaluatorScore</th>
            }
            else
            {
                <th rowspan="2">@Lang.Employee</th>
                <th colspan="2">@Lang.Evaluator</th>
            }

            <th colspan="2">@Lang.Reviewer</th>

            @if (Model.Process.Managements.Any())
            {
                <th colspan="2">@Lang.Management</th>
            }

            <th rowspan="2">@Lang.DisciplineScore</th>
            <th rowspan="2">@Lang.FinalScore</th>
            <th rowspan="2">@Lang.Grade</th>
        </tr>
        <tr>
            @if (!Model.IsSemiHasMonthly)
            {
                <th>@Lang.NickName</th>
                <th>@Lang.PerformanceScore</th>
            }

            @if (Model.Process.Managements.Any())
            {
                <th>@Lang.NickName</th>
                <th>@Lang.PerformanceScore</th>
            }

            <th>@Lang.NickName</th>
            <th>@Lang.PerformanceScore</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < rowspan; i++)
        {
            <tr>
                @if (Model.IsSemiHasMonthly)
                {
                    if (i == 0)
                    {
                        <td rowspan="@rowspan" class="border-r-b-l align-center">@Model.MonthlyEPA.AverageSelfScoreConverted</td>
                        <td rowspan="@rowspan" class="border-r-b align-center">@Model.MonthlyEPA.AverageEvaluatorScoreConverted</td>
                    }
                }
                else
                {
                    if (i == 0)
                    {
                        <td rowspan="@rowspan" class="border-r-b-l align-center">@GetScoreFromProcess(Model.Process.Self, Model.ScoreRatingType)</td>
                    }

                    if (i < Model.Process.Evaluators.Count)
                    {
                        <td class="border-r-b align-center">@Model.Process.Evaluators[i].EvaluatorInfo.NickName</td>
                        <td class="border-r-b align-center">@GetScoreFromProcess(Model.Process.Evaluators[i], Model.ScoreRatingType)</td>
                    }
                    else
                    {
                        <td class="border-r-b"></td>
                        <td class="border-r-b"></td>
                    }
                }

                @if (i < Model.Process.Reviewers.Count)
                {
                    <td class="border-r-b align-center">@Model.Process.Reviewers[i].EvaluatorInfo.NickName</td>
                    <td class="border-r-b align-center">@GetScoreFromProcess(Model.Process.Reviewers[i], Model.ScoreRatingType)</td>
                }
                else
                {
                    <td class="border-r-b"></td>
                    <td class="border-r-b"></td>
                }

                @if (Model.Process.Managements.Any())
                {
                    if (i < Model.Process.Managements.Count)
                    {
                        <td class="border-r-b align-center">@Model.Process.Managements[i].EvaluatorInfo.NickName</td>
                        <td class="border-r-b align-center">@GetScoreFromProcess(Model.Process.Managements[i], Model.ScoreRatingType)</td>
                    }
                    else
                    {
                        <td class="border-r-b"></td>
                        <td class="border-r-b"></td>
                    }
                }

                @if (i == 0)
                {
                    <td rowspan="@rowspan" class="border-r-b align-center">
                        @(Model.HasDisciplineScore
                              ? Model.DisciplineScore + " / " + Model.MaxDisciplineScore
                              : (Model.DisciplineScore != 0 ? Model.DisciplineScore.ToString() : "-"))
                    </td>
                    <td rowspan="@rowspan" class="border-r-b align-center">
                        @if (Model.StatusId == (int)EpaStatus.Closed)
                        {
                            if (!string.IsNullOrEmpty(Model.FinalScore))
                            {
                                @(Model.FinalScore + " / " + Model.MaxFinalScore)
                            }
                            else
                            {
                                @Model.FinalScoreToExport
                            }
                        }
                        else
                        {
                            <span class="red">@Model.FinalScoreToExport</span>
                        }
                    </td>
                    <td rowspan="@rowspan" class="border-r-b align-center">
                        @if (Model.StatusId == (int)EpaStatus.Closed)
                        {
                            @Model.Grade
                        }
                        else
                        {
                            <span class="red">@Model.Grade</span>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>