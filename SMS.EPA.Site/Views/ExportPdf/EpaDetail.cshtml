@using SMS.EPA.Resources
@using SMS.EPA.Model

@model EpaDetailModel
@{
    EPAModel epaInfo = Model.EpaInfo;
    Layout = null;
}

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="~/Content/Site/pdf.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="title">@Lang.EPATilte - @epaInfo.Period.Name</div>
        @Html.Partial("_GeneralInfo", epaInfo.Employee)
        @Html.Partial("_PerformanceResult", epaInfo)
        <br />
        @Html.Partial("_PerformanceDetail", epaInfo)

        @if (epaInfo.Recommendation != null)
        {
            @Html.Partial("_Recommendation", epaInfo)
        }

        <br />
        @Html.Partial("_Comment", epaInfo)
    </div>
</body>
</html>