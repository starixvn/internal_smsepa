@using SMS.EPA.Resources
@using SMS.EPA.Model

@model EPAModel
@{
    Layout = null;
}

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link href="~/Content/Site/pdf.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="title">@Lang.EPATilte - @Model.Period.Name</div>
        @Html.Partial("_GeneralInfo", Model.Employee)
        @if (Model.JobDescriptions != null && Model.JobDescriptions.Any())
        {
            @Html.Partial("_JobDescription", Model.JobDescriptions)
        }
        <br />
        @Html.Partial("_PerformanceResult", Model)

        @if (Model.Recommendations != null && Model.Recommendations.Any())
        {
            @Html.Partial("_Recommendation", Model)
        }

        @Html.Partial("_PerformanceDetail", Model)

        @if (Model.ExtendedQuestion != null && Model.ExtendedQuestion.SubQuestions.Any())
        {
            @Html.Partial("_ProbationExtendedQuestion", Model)
        }

        @Html.Partial("_Comment", Model)
    </div>
</body>
</html>